NODE_ENV=development
APP_NAME=MEDdonish
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002
HTTPS_WEB_ORIGIN=https://localhost:8443
HTTPS_ADMIN_ORIGIN=http://localhost:8081
SECRET_BACKEND=env
SECRET_DIR=./infrastructure/secrets

DATABASE_URL=postgresql://meddonish:meddonish@127.0.0.1:5433/meddonish
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_DEV_ECHO=true

SINGLE_DEVICE_POLICY=require_release

STORAGE_DRIVER=local
STORAGE_ROOT=./storage
MEDIA_SIGNING_SECRET=change-me-media
VIDEO_CHUNK_SIZE=8388608
# STORAGE_DRIVER=supabase uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY on the API only (never in Next.js).
# Create private bucket premium-media and public bucket public-media (plus course-media, avatars).

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=meddonish
S3_ACCESS_KEY=
S3_SECRET_KEY=

SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
# production: SMS_PROVIDER=http and SMS_API_URL=https://... ; OTP is never logged or stored
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

ADMIN_BOOTSTRAP_EMAIL=admin@meddonish.local
ADMIN_BOOTSTRAP_PASSWORD=MeddonishAdmin2026

WEB_PAYMENT_PROVIDER=sandbox
WEB_PAYMENT_API_URL=
