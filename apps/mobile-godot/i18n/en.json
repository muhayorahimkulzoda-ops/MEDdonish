  "legal.privacy": "Privacy Policy",
  "legal.terms": "Terms of Use",
  "legal.privacy.intro": "MEDdonish is an educational platform. We do not collect medical records, patient diagnoses, or clinical data of real people.",
  "legal.privacy.data": "We process phone number, device id, language, learning progress, and payment facts. OTP, PIN, tokens, and DRM keys are not stored in plaintext and are not written to logs.",
  "legal.privacy.access": "Lesson access is granted only by a server entitlement after payment.status = paid or an admin grant. The app store does not grant access.",
  "legal.terms.intro": "A subscription unlocks learning materials for a chosen period. This is not a medical service and does not replace clinical practice.",
  "legal.terms.pay": "Website checkout uses WEB_PAYMENT. Android and iOS apps use only Google Play and Apple IAP. The server sets the amount, not the client.",
  "legal.terms.device": "Only one device is active at a time. Protected content must not be downloaded as a source file or shared with third parties.",
  "legal.privacy.delete": "You can delete your account in the profile or on the account deletion page. Phone, PIN, and devices are erased. Anonymized payment facts are kept for accounting.",
  "legal.accountDeletion": "Account deletion",
  "legal.accountDeletion.intro": "Google Play and the App Store require a way to delete the account in the app and on the website.",
  "legal.accountDeletion.how": "Sign in, open your profile, and confirm deletion with the word DELETE. The same phone number can register again as a new account.",
  "legal.accountDeletion.keeps": "Only anonymized payment facts are retained. Entitlements are revoked immediately.",
  "account.delete": "Delete account",
  "account.delete.confirm": "Deletion is permanent. Type DELETE to confirm.",
  "account.delete.done": "Account deleted",
  "account.export": "Download my data",
  "legal.privacy.export": "You can download your data from the profile as JSON. The file does not include PIN, tokens, OTP, or DRM keys."
